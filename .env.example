# Copy to .env.local for local development. Set the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://iywzvhaxpnbrfertuxcj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The deployed site URL (used for Apify webhooks). Optional on Vercel: falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# APP_DB_SECRET must equal private.app_config('app_secret') in the database (see migration 0005).
APP_DB_SECRET=
VISITOR_COOKIE_SECRET=
APIFY_TOKEN=
DATA_GOV_IN_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Random strings: protect the Apify webhook and the Vercel cron route
APIFY_WEBHOOK_SECRET=
CRON_SECRET=

# Cost guard
DAILY_APIFY_SPEND_CAP_USD=6
DAILY_SYNC_MAX_RESULTS=2000
