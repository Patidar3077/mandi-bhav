# Copy to .env.local for local development. Set the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://iywzvhaxpnbrfertuxcj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The deployed site URL (used for Apify webhooks). Optional on Vercel: falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
APIFY_TOKEN=
DATA_GOV_IN_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Random strings: protect the Apify webhook and the Vercel cron route
APIFY_WEBHOOK_SECRET=
CRON_SECRET=

# Login-code emails sent by the app (any SMTP provider). Leave empty to use Supabase's built-in email.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter Google App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Mandi Bhav <you@gmail.com>

# Cost guard
DAILY_APIFY_SPEND_CAP_USD=5
DAILY_SYNC_MAX_RESULTS=3000
